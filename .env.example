# ── ИИ-консультант на сайте ──────────────────────────────────────
# Ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно. По умолчанию claude-haiku-4-5 — самый быстрый вариант,
# а вопросы на лендинге простые. Для более развёрнутых ответов подойдёт
# claude-sonnet-5.
ANTHROPIC_MODEL=claude-haiku-4-5
